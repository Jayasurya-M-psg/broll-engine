# ─────────────────────────────────────────────────────────────────────────────
# BrollEngine — Environment Configuration
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=BrollEngine
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=broll-outputs
MINIO_SECURE=false
# Set to the public hostname/IP of your MinIO instance for external access
MINIO_PUBLIC_URL=http://localhost:9000

# ── Footage Sources ───────────────────────────────────────────────────────────
# Get a free API key at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Get a free API key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# ── AI Generative Fallback (optional) ────────────────────────────────────────
# Get from https://replicate.com — only used when both stock sources fail
REPLICATE_API_TOKEN=
AI_GEN_ENABLED=true

# ── Transcription ─────────────────────────────────────────────────────────────
# Whisper model size: tiny | base | small | medium | large
# Larger = more accurate but slower. "base" is a good default.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# ── TTS ───────────────────────────────────────────────────────────────────────
# TTS engine: edge | espeak | coqui
TTS_ENGINE=edge
TTS_DEFAULT_VOICE=en-US-JennyNeural

# ── Relevance Scoring ─────────────────────────────────────────────────────────
CLIP_ENABLED=true

# ── Video Output ──────────────────────────────────────────────────────────────
VIDEO_FPS=30
DEFAULT_ASPECT_RATIOS=16:9

# ── Job Settings ──────────────────────────────────────────────────────────────
JOB_TIMEOUT_SEC=900
IDEMPOTENCY_TTL_SEC=86400
# Change this to a strong random secret in production!
CALLBACK_HMAC_SECRET=change-me-in-production

# ── Batch Runner ──────────────────────────────────────────────────────────────
BATCH_OUTPUT_DIR=batch_results
